# ---- Секрети та креденшели (найважливіше для k8s-проєкту) ----
*.key
*.pem
*.crt
*.p12
*.pfx
kubeconfig
kubeconfig-*
*.kubeconfig
.kube/
secrets/
*secret*.yaml
!*secret*.example.yaml
!*secret*.template.yaml
.env
.env.*
!.env.example

# ---- Helm ----
charts/*.tgz
**/charts/*.tgz
**/Chart.lock
**/requirements.lock
.helm-values.local.yaml
values.local.yaml

# ---- Kustomize / згенеровані маніфести ----
build/
dist/
rendered/
*.generated.yaml

# ---- Terraform (якщо буде провіженінг кластера) ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ---- Локальні кластери ----
.minikube/
.kind/
.vagrant/

# ---- Логи, тимчасові файли ----
*.log
*.tmp
*.bak
*.orig
tmp/

# ---- IDE / редактори ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---- macOS / Windows / Linux ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
